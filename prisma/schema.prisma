generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  order       Int      @default(0)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String
  price          Int        // Rupiah — stored as integer to avoid floating-point errors
  wholesalePrice Int        // Rupiah — stored as integer to avoid floating-point errors
  minOrder       Int        @default(1)
  stock          Int
  images         String
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  rating         Float      @default(0)
  reviewCount    Int        @default(0)
  sold           Int        @default(0)
  featured       Boolean    @default(false)
  tags           String?
  weight         String?
  sizes          String?    // Ukuran (comma-separated), mis: S, M, L, XL
  colors         String?    // Warna (comma-separated), mis: Merah, Hitam, Putih
  variantName    String?    // Nama jenis variant lain (mis: "Material", "Tipe", "Model")
  variants       String?    // Nilai variant lain (comma-separated), mis: Katun, Jeans, Sutra
  supplierName   String?    // Nama supplier/toko supplier
  supplierLink   String?    // Link alamat toko supplier (Shopee, Tokopedia, dll)
  supplierPhone  String?    // No telp/WhatsApp supplier
  deletedAt      DateTime?  // Soft delete: null = active, set date = deleted
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([categoryId])
  @@index([deletedAt])
  @@index([deletedAt, categoryId])
  @@index([featured, deletedAt])
  @@index([sold])
  @@index([wholesalePrice])
  @@index([createdAt])
  @@index([rating])
  @@index([stock])
  @@index([deletedAt, sold])
  @@index([deletedAt, wholesalePrice])
  @@index([deletedAt, name])       // Search: filter by deletedAt + name prefix
  @@index([deletedAt, featured])   // Featured products query optimization
}

model CartItem {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  size      String?
  color     String?
  variant   String?
  sessionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([productId])
  @@unique([sessionId, productId, size, color, variant])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("admin") // admin, staff
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddr    String?
  status          String      @default("pending") // pending, confirmed, processing, shipped, completed, cancelled
  paymentMethod   String      @default("whatsapp") // whatsapp, transfer, cod
  paymentStatus   String      @default("unpaid") // unpaid, paid, refunded
  totalAmount     Int         @default(0) // Rupiah — integer to avoid floating-point errors
  shippingCost    Int         @default(0) // Rupiah — integer
  courier         String?
  courierService  String?
  destinationCity String?
  note            String?
  paymentProof    String?     // Cloudinary URL — bukti pembayaran dari user
  paymentNotes    String?     // Catatan pembayaran dari user
  paidAt          DateTime?   // Waktu pembayaran dikonfirmasi admin
  deletedAt       DateTime?   // Soft delete — orders should NEVER be hard-deleted for audit
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([paymentStatus, deletedAt])
  @@index([deletedAt, orderNumber])   // Admin order search by orderNumber
  @@index([deletedAt, customerName])  // Admin order search by customer name
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product? @relation(fields: [productId], references: [id]) // Optional — product may be soft-deleted
  quantity     Int
  size         String?
  color        String?
  variant      String?
  price        Int      // Price at time of order (Rupiah — integer)
  productName  String   // Snapshot: product name at time of order (prevents data loss if product changes)
  productImage String   // Snapshot: first image at time of order
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String?          // URL when clicked (e.g. /category-slug or external)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingZone {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  provinces String         // Comma-separated province names
  order     Int            @default(0)
  active    Boolean        @default(true)
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([active])
  @@index([order])
}

model ShippingRate {
  id           String        @id @default(cuid())
  zoneId       String
  zone         ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  courier      String        // e.g. jne, jnt, sicepat
  service      String        // e.g. REG, YES, ECO
  serviceLabel String        // e.g. JNE REGULER, JNE YES
  firstKg      Int           // Price for first kg in Rupiah
  nextKg       Int           // Price per additional kg in Rupiah
  etd          String        @default("-") // Estimated time of delivery
  active       Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([zoneId, courier, service])
  @@index([zoneId])
  @@index([active])
  @@index([courier])
}
