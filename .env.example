# ============================================================
# GrosirPJ — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# For Vercel deployment, add ALL these in Vercel Dashboard → Settings → Environment Variables
# ============================================================

# --- Database (Required) ---
# Local development (SQLite):
DATABASE_URL="file:./db/custom.db"

# Production (Turso cloud):
# Get these from https://turso.tech dashboard
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..."

# --- Authentication (Required) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# Production URL (your Vercel domain):
NEXTAUTH_URL="https://your-app.vercel.app"

# --- Cloudinary (Required for image upload) ---
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Optional ---
# NODE_ENV="production"
